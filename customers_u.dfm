      object RichEdit1: TRichEdit
        Left = 3
        Top = 40
        Width = 766
        Height = 438
        Font.Charset = ANSI_CHARSET
        Font.Color = clWindowText
        Font.Height = -16
        Font.Name = 'JetBrains Mono'
        Font.Style = []
        Lines.Strings = (
          #55357#56420' Consumer Role & System Interactions'
          
            'The Consumer interacts with the OptiCorp platform as the primary' +
            ' end-user, '
          
            'utilizing the system'#39's expert algorithms to make informed fashio' +
            'n choices '
          
            'and seamlessly purchase new items. Their core interactions withi' +
            'n the '
          'application are divided into three main areas:'
          ''
          
            'Profile & Digital Wallet Management: The consumer is responsible' +
            ' for '
          
            'maintaining their personal account and managing their purchasing' +
            ' power. '
          
            'They access a simulated digital wallet interface where they can ' +
            'virtually '
          
            'deposit funds, seamlessly updating their available balance to en' +
            'sure they '
          
            'have enough money to buy the clothing items recommended to them ' +
            'by the '
          'system.'
          ''
          
            'Outfit Expert System Navigation: The standout feature for the co' +
            'nsumer is '
          
            'their interaction with the personal digital stylist. The user mu' +
            'st '
          
            'accurately input their current environmental variables, such as ' +
            'today'#39's '
          
            'local temperature and the specific formality of their upcoming e' +
            'vent. They '
          
            'then trigger the algorithm, which extensively filters through th' +
            'e physical '
          
            'inventory and their personal digital wardrobe to recommend the p' +
            'erfect '
          'matching outfit.'
          ''
          
            'Purchasing & Order Generation: If the expert system recommends a' +
            ' specific '
          
            'item of clothing that the consumer does not currently own, they ' +
            'are given '
          
            'the immediate opportunity to purchase it. The consumer finalizes' +
            ' the '
          
            'checkout process, which instantly deducts the precise cost from ' +
            'their '
          
            'digital wallet, reduces the global stock quantity in the invento' +
            'ry '
          
            'database, and automatically generates a brand new delivery order' +
            ' for the '
          'warehouse dispatch team to fulfill.')
        ParentFont = False
        ScrollBars = ssVertical
        TabOrder = 0
      end
